{
  "name": "tetherline",
  "private": true,
  "version": "1.0.0",
  "description": "A factory builder for the browser, played in one-hour Quick Rounds: drills, belts, power and a space elevator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bot": "BOT_LONG=1 vitest run src/sim/bot.test.ts",
    "shots": "node scripts/shots.mjs",
    "artsheet": "tsx scripts/artsheet.ts",
    "listen": "node scripts/listen.mjs",
    "perf": "node scripts/perf.mjs",
    "art": "node scripts/art.mjs",
    "bench": "tsx scripts/bench.ts",
    "autopilot": "tsx scripts/autopilot.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
